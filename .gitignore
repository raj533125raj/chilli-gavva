# Secrets: never commit API keys
config.json
# Python build/cache
__pycache__/
*.pyc
# Worker single-instance lock
worker.lock
# Local database backups
backups/
# Generated pages from approved drafts (never leak drafts into a public repo)
site/*
!site/.gitkeep
# Code patch proposals (reviewed locally, applied by a human)
proposals/
# Daily reports
reports/
# Local-only files (roadmap #41). agent_data.db stays tracked on purpose (private repo, saved by the bot).
*.sqlite
.env
.env.*
archive/
old_copy_*/
team/
logs/
# NOT ignored on purpose: .scheduler_locks/ - the "Save state" step must commit the night-run locks, and
# `git add .scheduler_locks` fails (exit 1) when that folder is in .gitignore.
